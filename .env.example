# Copy to .env. No secrets are required: the Elexon Insights API is keyless.
# --- backend ---
ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1
HTTP_TIMEOUT_S=30
HTTP_RETRIES=3
CHUNK_DAYS=1
CACHE_DIR=app/data/cache
DEFAULT_CUTOFF_LOCAL=09:20
# Comma-separated list of allowed browser origins (set to your Vercel URL in production)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
WINDOW_START=2026-01-01
WINDOW_END=2026-01-31
LOG_LEVEL=INFO
# --- frontend (build-time) ---
VITE_API_BASE_URL=http://localhost:8000
